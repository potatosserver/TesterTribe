rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getAppData(appId) {
      return get(/databases/$(database)/documents/apps/$(appId)).data;
    }

    // --- Collections ---

    // ✅ Users: 允許所有人讀取公開資料，僅允許本人寫入
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ✅ Core Apps (主 App 數據集) - 統一使用 apps 集合
    match /apps/{appId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      allow update: if
              // 作者：可改內容，但不能改 authorUid、createdAt、計數欄位
              (isOwner(resource.data.authorUid)
                && request.resource.data.authorUid == resource.data.authorUid
                && request.resource.data.createdAt == resource.data.createdAt
                && request.resource.data.likeCount == resource.data.likeCount
                && request.resource.data.joinCount == resource.data.joinCount
                && request.resource.data.ratingCount == resource.data.ratingCount
                && request.resource.data.ratingSum == resource.data.ratingSum)
              ||
              // 非作者：僅允許點讚/加入/評分的原子操作（檢查受影響欄位）
              (isSignedIn()
                && request.resource.data.authorUid == resource.data.authorUid
                && request.resource.data.createdAt == resource.data.createdAt
                && (
                  // 按讚：僅修改 likeCount
                  (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']))
                  ||
                  // 加入測試：僅修改 joinCount
                  (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCount']))
                  ||
                  // 評分：僅修改 ratingCount, ratingSum, newRatingScore 且分數 1-5
                  (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingCount', 'ratingSum', 'newRatingScore'])
                    && request.resource.data.newRatingScore >= 1
                    && request.resource.data.newRatingScore <= 5)
                ));

      allow delete: if isOwner(resource.data.authorUid);

      // 互動子集合
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId)
          && getAppData(appId).authorUid != request.auth.uid;
      }

      match /testers/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /ratings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId)
          && getAppData(appId).authorUid != request.auth.uid
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5;
      }

      match /feedbacks/{userId} {
        allow read: if true;

        allow create: if isOwner(userId)
          && (request.resource.data.type != 'review' || getAppData(appId).authorUid != request.auth.uid);

        allow update: if isSignedIn() && (
          (isOwner(userId) && (request.resource.data.type != 'review' || getAppData(appId).authorUid != request.auth.uid))
          || isOwner(getAppData(appId).authorUid)
        );

        allow delete: if isSignedIn()
          && (isOwner(userId) || isOwner(getAppData(appId).authorUid));
      }
    }

    // 預設拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}